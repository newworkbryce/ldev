#!/usr/bin/env bash
#
# ldev — manage the local development TLD.
#
#   ldev doctor      check every layer separately and say which one is broken
#   ldev list        sites discovered under the sites directory
#   ldev new <name>  create a site directory (and an index.html if empty)
#   ldev apply       re-render the server config from the template
#   ldev restart     restart the server
#   ldev status      is it running, and on what
#   ldev config      print the saved configuration

set -uo pipefail

CONFIG_FILE="$HOME/.config/ldev/config"
[ -f "$CONFIG_FILE" ] || { echo "ldev: not installed — run install.sh first (no $CONFIG_FILE)" >&2; exit 1; }
# shellcheck disable=SC1090
. "$CONFIG_FILE"

BREW_PREFIX="$(brew --prefix 2>/dev/null || echo /opt/homebrew)"
CADDYFILE="$HOME/.config/ldev/Caddyfile"
VHOSTS="$HOME/.config/ldev/httpd-vhosts.conf"   # apache mode: the file httpd.conf includes
CERTDIR="$HOME/.config/ldev/certs"              # apache mode: one mkcert pair per host

# Modules the generated vhost file needs, and which a stock Homebrew httpd.conf ships
# commented out. Missing ones are a startup error naming a directive, not a module.
HTTPD_MODULES="vhost_alias rewrite proxy proxy_fcgi ssl socache_shmcb"

if [ -t 1 ]; then
  B=$'\033[1m'; R=$'\033[0m'; GRN=$'\033[32m'; RED=$'\033[31m'; YEL=$'\033[33m'; DIM=$'\033[2m'
else
  B=""; R=""; GRN=""; RED=""; YEL=""; DIM=""
fi

ok()   { printf '  %s✓%s %s\n' "$GRN" "$R" "$*"; }
bad()  { printf '  %s✗%s %s\n' "$RED" "$R" "$*"; FAILED=1; }
note() { printf '  %s·%s %s\n' "$YEL" "$R" "$*"; }
fix()  { printf '      %s%s%s\n' "$DIM" "$*" "$R"; }

cmd_doctor() {
  FAILED=0
  printf '\n%sldev doctor%s  — TLD .%s, mode %s\n\n' "$B" "$R" "$TLD" "$MODE"

  # Each layer is checked on its own, because they fail independently and a
  # working layer above a broken one is exactly what makes this confusing:
  # DNS resolving while nothing listens on 443 looks like "DNS is broken".

  printf '%sDNS%s\n' "$B" "$R"
  local probe="ldev-doctor-probe.$TLD" ip
  ip="$(dscacheutil -q host -a name "$probe" 2>/dev/null | awk '/^ip_address:/{print $2; exit}')"
  if [ "$ip" = "127.0.0.1" ]; then
    ok "*.$TLD resolves to 127.0.0.1 (tested $probe)"
  else
    bad "*.$TLD does not resolve${ip:+ (got $ip)}"
    [ -f "/etc/resolver/$TLD" ] || fix "missing /etc/resolver/$TLD — echo 'nameserver 127.0.0.1' | sudo tee /etc/resolver/$TLD"
    pgrep -x dnsmasq >/dev/null || fix "dnsmasq is not running — sudo brew services restart dnsmasq"
  fi

  printf '\n%sListeners%s\n' "$B" "$R"
  local any=0
  for p in 80 443; do
    if nc -z 127.0.0.1 "$p" 2>/dev/null; then ok "port $p is listening"; any=1
    else
      # apache mode uses 80 and 443 exactly as auto does — the server behind them differs,
      # the requirement does not. Only persite leaves them alone.
      if [ "$MODE" = "auto" ] || [ "$MODE" = "apache" ]; then bad "port $p is not listening"
      else note "port $p is not listening (mode '$MODE' does not use it)"; fi
    fi
  done
  if [ "$MODE" = "auto" ] && [ "$any" = 0 ]; then
    fix "start the service — sudo launchctl bootstrap system /Library/LaunchDaemons/com.ldev.caddy.plist"
  fi
  if [ "$MODE" = "apache" ] && [ "$any" = 0 ]; then
    fix "start httpd as root (80 and 443 are privileged) — sudo brew services start httpd"
    fix "and check httpd.conf listens on 80 and 443, not the Homebrew default 8080"
  fi

  printf '\n%sPHP%s\n' "$B" "$R"
  local host="${PHP_FPM%:*}" port="${PHP_FPM##*:}"
  if nc -z "$host" "$port" 2>/dev/null; then ok "PHP-FPM answering on $PHP_FPM"
  else
    bad "nothing on $PHP_FPM — PHP sites will return an empty page"
    fix "brew services start php"
  fi

  printf '\n%sConfig%s\n' "$B" "$R"
  if [ "$MODE" = "apache" ]; then
    if [ -f "$VHOSTS" ]; then
      local verr vrc
      verr="$(httpd_validate "$VHOSTS")"; vrc=$?
      if   [ "$vrc" = 0 ]; then ok "$VHOSTS validates"
      elif [ "$vrc" = 2 ]; then note "httpd is not installed — cannot check $VHOSTS"
      else bad "$VHOSTS is invalid"; printf '%s\n' "$verr" | tail -3 | sed 's/^/      /'; fi
    else
      bad "no vhost file at $VHOSTS"; fix "ldev apply"
    fi

    # A module the file needs but httpd has not loaded fails as an "Invalid command"
    # naming a directive, which reads as a typo in the config rather than a missing
    # module. Name the module instead.
    local missing="" m
    if command -v httpd >/dev/null 2>&1; then
      local loaded; loaded="$(httpd -M 2>/dev/null)"
      for m in $HTTPD_MODULES; do
        printf '%s' "$loaded" | grep -q "${m}_module" || missing="$missing $m"
      done
      if [ -z "$missing" ]; then ok "httpd modules loaded:$(printf ' %s' $HTTPD_MODULES)"
      else
        bad "httpd modules not loaded:$missing"
        fix "uncomment their LoadModule lines in $BREW_PREFIX/etc/httpd/httpd.conf"
      fi
    fi

    grep -qs "Include.*$VHOSTS" "$BREW_PREFIX/etc/httpd/httpd.conf" \
      && ok "httpd.conf includes $VHOSTS" \
      || { bad "httpd.conf does not include $VHOSTS"
           fix "echo 'Include $VHOSTS' >> $BREW_PREFIX/etc/httpd/httpd.conf"; }
  fi
  if [ "$MODE" = "auto" ]; then
    if [ -f "$CADDYFILE" ]; then
      if caddy validate --config "$CADDYFILE" >/dev/null 2>&1; then ok "Caddyfile validates"
      else bad "Caddyfile is invalid"; fix "caddy validate --config $CADDYFILE"; fi
    else
      bad "no Caddyfile at $CADDYFILE"; fix "ldev apply"
    fi
  fi
  [ -d "$SITES" ] && ok "sites directory $SITES" || bad "missing sites directory $SITES"

  # `shop` and `shop.$TLD` are one hostname with two folders, and the plain one wins.
  # Editing the shadowed folder and seeing nothing change is a long hour, so name it here.
  local d base
  for d in "$SITES"/*."$TLD"; do
    [ -d "$d" ] || continue
    base="$(basename "$d")"
    [ -d "$SITES/${base%.$TLD}" ] \
      && note "$base and ${base%.$TLD} are one hostname — https://$base/ serves ${base%.$TLD}"
  done
  [ -f "$DASHBOARD/index.html" ] && ok "dashboard built" || { bad "dashboard not built"; fix "cd $REPO_DIR/dashboard && npm run build"; }

  printf '\n%sEnd to end%s\n' "$B" "$R"
  local code
  # WHAT to fetch depends on the mode, and getting that wrong is worse than not checking.
  #
  # `https://<tld>/` is the auto-mode dashboard. In per-site mode nothing owns 443 — that is the
  # documented behaviour of the mode, not a fault — so asking for it always failed, and doctor
  # reported a healthy install as broken. A check that answers a different question than the one
  # the operator is asking is how you send somebody debugging something that was never wrong.
  if [ "$MODE" = "persite" ]; then
    local found=0
    for f in "$SITES"/*/Caddyfile; do
      [ -f "$f" ] || continue
      found=1
      local host port addr host_re
      # Both folder layouts, plain and .$TLD-suffixed, name the same host.
      host="$(site_host "$(dirname "$f")")"
      # Dots in the host would otherwise match any character in the pattern below.
      host_re="${host//./\\.}"
      # A Caddy address line can carry several hosts: `matsu.ldev, matsu-dev.ldev:8444 {`.
      # Each address is INDEPENDENT, so a host written without a port is served on 443 rather
      # than on its neighbour's port — reading the first port on the line would report the wrong
      # URL for the host that has none. Match this host's own token, and default it to 443.
      # Only real address lines: not comments, and ending in the `{` that opens a site block.
      # Every one of these Caddyfiles names its host in a header comment too, and matching that
      # first reported the host as portless — so every site came back as 443.
      addr="$(grep -vE '^[[:space:]]*#' "$f" | grep -E '\{[[:space:]]*$' \
        | grep -oE "(^|[, ])$host_re(:[0-9]+)?" | head -1 | tr -d ' ,')"
      if [ -z "$addr" ]; then note "$host — no address for it in its Caddyfile"; continue; fi
      port="${addr##*:}"
      [ "$port" = "$addr" ] && port=443
      # No -k. The auto branch below validates the certificate, and a ✓ has to mean the same
      # thing in both — a site whose cert nothing trusts is a real fault, not one to skip past.
      code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "https://$host:$port/" 2>/dev/null)"
      if [ "$code" = "200" ]; then ok "https://$host:$port/ returned 200"
      elif [ "$code" = "000" ]; then bad "https://$host:$port/ did not connect — is its caddy running?"
      else note "https://$host:$port/ returned $code"; fi
    done
    [ "$found" = 0 ] && note "no per-site Caddyfiles yet — ldev new <name> writes one"
  else
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "https://$TLD/" 2>/dev/null)"
    if [ "$code" = "200" ]; then ok "https://$TLD/ returned 200"
    elif [ "$code" = "000" ]; then bad "https://$TLD/ did not connect"
    else note "https://$TLD/ returned $code"; fi

    # In apache mode the two protocols are served by different machinery — a wildcard
    # vhost for HTTP, a generated per-site vhost for HTTPS — so one working says nothing
    # about the other. Probe a real site over both rather than inferring.
    if [ "$MODE" = "apache" ]; then
      local first p
      first="$(site_pairs | head -1 | cut -f1)"
      if [ -z "$first" ]; then note "no sites yet — ldev new <name>"
      else
        for p in "http://$first/" "https://$first/"; do
          code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "$p" 2>/dev/null)"
          if [ "$code" = "200" ]; then ok "$p returned 200"
          elif [ "$code" = "000" ]; then
            bad "$p did not connect"
            case "$p" in https:*) fix "issue its vhost and certificate — ldev apply" ;; esac
          else note "$p returned $code"; fi
        done
      fi
    fi
  fi

  printf '\n'
  [ "$FAILED" = 0 ] && printf '%sAll checks passed.%s\n\n' "$GRN" "$R" || printf '%sSome checks failed — see the hints above.%s\n\n' "$RED" "$R"
  return "$FAILED"
}

# The hostname a directory answers to. A folder is named for the site and nothing else
# ("shop"), but folders created before that carry the TLD ("shop.ldev") and are still
# served, so both have to resolve to the same host here.
site_host() {
  local name="${1##*/}"
  printf '%s.%s\n' "${name%.$TLD}" "$TLD"
}

cmd_list() {
  printf '\n%sSites in %s%s\n\n' "$B" "$SITES" "$R"
  local found=0
  for d in "$SITES"/*; do
    [ -d "$d" ] || continue
    found=1
    local name host kind shadowed=""
    name="$(basename "$d")"
    host="$(site_host "$d")"
    if   [ -f "$d/wp-config.php" ]; then kind="WordPress"
    elif [ -f "$d/index.php" ];     then kind="PHP"
    elif [ -f "$d/index.html" ];    then kind="static"
    else                                 kind="${YEL}no index${R}"; fi
    # Two folders, one hostname: say which one is actually being served rather than
    # printing the same URL twice and leaving the reader to guess.
    [ "$name" != "${name%.$TLD}" ] && [ -d "$SITES/${name%.$TLD}" ] \
      && shadowed="  ${YEL}(shadowed by ${name%.$TLD}/)${R}"
    printf '  %-40s %-12s https://%s/%s\n' "$name" "$kind" "$host" "$shadowed"
  done
  [ "$found" = 0 ] && printf '  (none yet — ldev new <name>)\n'
  printf '\n'
}

# Ports already claimed by sibling site Caddyfiles, one per line.
#
# Read from the FILES, not from listening sockets: a site that is currently stopped still
# owns its ports, and allocating around only what is running would hand a new site a pair
# that collides the moment the old one starts again.
persite_used_ports() {
  grep -hoE '(admin localhost:|:)[0-9]{4,5}' "$SITES"/*/Caddyfile 2>/dev/null \
    | grep -oE '[0-9]{4,5}$' | sort -un
}

# The next free (site, admin) pair, kept in step: 8443/2019, 8444/2020, ...
#
# Both must be free TOGETHER. Allocating them independently is exactly the bug this
# exists to prevent: the site port increments, the admin port stays at the default, and
# the second Caddy exits at startup because two processes cannot share an admin port.
# That failure is silent — the site simply never comes up.
persite_next_ports() {
  local site_base="${SITE_PORT_BASE:-8443}" admin_base="${ADMIN_PORT:-2019}"
  local used n site admin
  used="$(persite_used_ports)"
  for n in $(seq 0 200); do
    site=$((site_base + n)); admin=$((admin_base + n))
    printf '%s\n' "$used" | grep -qx "$site" && continue
    printf '%s\n' "$used" | grep -qx "$admin" && continue
    # Also skip anything currently bound by an unrelated process, so ldev never hands out
    # a port something outside ldev already answers on.
    #
    # LDEV_SKIP_PORT_PROBE exists for tests: the probe reads the real machine, so a test
    # asserting "the first pair is 8443/2019" fails on any machine already serving 8443 —
    # which is every machine ldev is actually used on. Config-file scanning above is the
    # deterministic half and is what the tests exercise.
    if [ "${LDEV_SKIP_PORT_PROBE:-0}" != "1" ]; then
      nc -z 127.0.0.1 "$site" 2>/dev/null && continue
      nc -z 127.0.0.1 "$admin" 2>/dev/null && continue
    fi
    printf '%s %s\n' "$site" "$admin"
    return 0
  done
  echo "ldev: no free site/admin port pair within 200 of $site_base/$admin_base" >&2
  return 1
}

cmd_new() {
  local name="${1:?usage: ldev new <name>}"
  name="${name%.$TLD}"
  # A hostname label, and nothing else. `ldev new ../../foo` would otherwise write outside
  # $SITES — and outside the glob the port allocator scans, so the next site would be handed
  # a port this one already holds. A `|` would also break the sed replacement below.
  [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || {
    echo "ldev: '$name' is not a site name — letters, digits, dot, dash and underscore only" >&2
    exit 1
  }
  # The folder is named for the site, with no .$TLD suffix: the hostname already supplies
  # that, and repeating it in the directory name meant an existing project could not be
  # served without renaming it first. A folder that IS suffixed still works, so an install
  # made before this keeps serving — and is reused here rather than shadowed by a second,
  # empty folder for the same hostname.
  local dir="$SITES/$name"
  [ -d "$dir" ] && { echo "ldev: $dir already exists"; exit 1; }
  [ -d "$SITES/$name.$TLD" ] && {
    echo "ldev: $SITES/$name.$TLD already exists and is served at https://$name.$TLD/"
    exit 1
  }
  mkdir -p "$dir"
  cat > "$dir/index.html" <<EOF
<!doctype html>
<meta charset="utf-8">
<title>$name.$TLD</title>
<body style="font:16px/1.6 system-ui;margin:4rem auto;max-width:34rem">
<h1>$name.$TLD</h1>
<p>Created by <code>ldev new</code>. Replace this file with your site.</p>
</body>
EOF
  echo "created $dir"

  # Apache serves the folder over HTTP the moment it exists — port 80 is wildcard — but
  # HTTPS needs a vhost and a certificate naming this host, which `ldev apply` writes.
  # Saying so here is the difference between "https is broken" and "one command left".
  if [ "${MODE:-auto}" = "apache" ]; then
    echo "        http://$name.$TLD/   (live now)"
    echo "        https://$name.$TLD/  after: ldev apply"
    return 0
  fi

  # In auto mode a directory IS the whole site: one Caddy resolves it per request, so a
  # new folder is live immediately and needs no config and no restart.
  if [ "${MODE:-auto}" != "persite" ]; then
    echo "        https://$name.$TLD/"
    return 0
  fi

  # Per-site mode needs its own Caddyfile, and needs its two ports not to collide with
  # any sibling's. Doing this by hand is what left the second site permanently down.
  local ports site_port admin_port
  ports="$(persite_next_ports)" || return 1
  site_port="${ports% *}"; admin_port="${ports#* }"

  sed -e "s|__NAME__|$name|g" -e "s|__TLD__|$TLD|g" -e "s|__SITE_DIR__|$dir|g" \
      -e "s|__SITE_PORT__|$site_port|g" -e "s|__ADMIN_PORT__|$admin_port|g" \
      -e "s|__PHP_FPM__|$PHP_FPM|g" -e "s|__LOGDIR__|$LOGDIR|g" \
      "$REPO_DIR/templates/Caddyfile.persite.tmpl" > "$dir/Caddyfile"

  if caddy validate --config "$dir/Caddyfile" >/dev/null 2>&1; then
    echo "        wrote $dir/Caddyfile (site $site_port, admin $admin_port)"
  else
    echo "        ${YEL}wrote $dir/Caddyfile but it does NOT validate${R}" >&2
    echo "        caddy validate --config $dir/Caddyfile" >&2
    return 1
  fi
  echo "        https://$name.$TLD:$site_port/"
  echo "        start it: cd $dir && caddy run"
}

# ---------------------------------------------------------------- apache mode
#
# Apache cannot do what auto mode does with one block: it has no on-demand certificate
# issuance, and a wildcard *.$TLD cert is rejected by browsers for a single-label parent.
# So HTTP is wildcard (mod_vhost_alias derives the root from the hostname) and HTTPS is
# generated — one vhost and one mkcert pair per site folder, rewritten by `ldev apply`.

# Each site once, as "<host>\t<dir>". A plain folder and a suffixed one are the SAME
# host, and emitting both would write two vhosts with one ServerName — Apache takes the
# first and silently ignores the second, which is a confusing way to serve the wrong
# directory. Plain wins, matching auto mode.
site_pairs() {
  local d name
  for d in "$SITES"/*; do
    [ -d "$d" ] || continue
    name="$(basename "$d")"
    [ "$name" != "${name%.$TLD}" ] && [ -d "$SITES/${name%.$TLD}" ] && continue
    printf '%s\t%s\n' "$(site_host "$d")" "$d"
  done
}

# A certificate pair for one host, issued once and reused. mkcert names the host
# explicitly, which is the whole point — see the wildcard note above.
ensure_cert() {
  local host="$1"
  mkdir -p "$CERTDIR"
  [ -s "$CERTDIR/$host.pem" ] && [ -s "$CERTDIR/$host-key.pem" ] && return 0
  command -v mkcert >/dev/null 2>&1 || {
    echo "ldev: mkcert is not installed — cannot issue a certificate for $host" >&2
    return 1
  }
  mkcert -cert-file "$CERTDIR/$host.pem" -key-file "$CERTDIR/$host-key.pem" "$host" >/dev/null 2>&1
}

# `httpd -t` on the generated file ALONE, via a throwaway wrapper that loads exactly the
# modules it needs. Checking the machine's real httpd.conf instead would answer a
# different question: it fails for reasons that have nothing to do with this file, and it
# cannot be run at all until the operator has already added the Include.
httpd_validate() {
  local f="$1" tmp root m out
  command -v httpd >/dev/null 2>&1 || return 2
  root="$BREW_PREFIX/opt/httpd"
  [ -d "$root/lib/httpd/modules" ] || root="$BREW_PREFIX"
  tmp="$(mktemp -d)" || return 2
  {
    printf 'ServerRoot "%s"\nServerName ldev-validate\nPidFile "%s/httpd.pid"\nErrorLog "%s/error.log"\n' "$root" "$tmp" "$tmp"
    for m in mpm_event authz_core authz_host unixd mime dir log_config $HTTPD_MODULES; do
      printf 'LoadModule %s_module lib/httpd/modules/mod_%s.so\n' "$m" "$m"
    done
    printf 'Include "%s"\n' "$f"
  } > "$tmp/httpd.conf"
  out="$(httpd -t -f "$tmp/httpd.conf" 2>&1)"
  local rc=$?
  rm -rf "$tmp"
  [ "$rc" = 0 ] || printf '%s\n' "$out"
  return "$rc"
}

cmd_apply_apache() {
  mkdir -p "$CERTDIR" "$LOGDIR" "$(dirname "$VHOSTS")"

  # The dashboard's own cert. It is also the FIRST :443 vhost, so it is what an unknown
  # https host reaches — see the header comment in the template.
  ensure_cert "$TLD" || { echo "ldev: no certificate for $TLD — not writing $VHOSTS" >&2; exit 1; }

  sed -e "s|__TLD__|$TLD|g" -e "s|__SITES__|$SITES|g" -e "s|__DASHBOARD__|$DASHBOARD|g" \
      -e "s|__PHP_FPM__|$PHP_FPM|g" -e "s|__CERTDIR__|$CERTDIR|g" -e "s|__LOGDIR__|$LOGDIR|g" \
      "$REPO_DIR/templates/httpd-vhosts.tmpl" > "$VHOSTS.new"

  local host dir name count=0 skipped=0
  while IFS=$'\t' read -r host dir; do
    [ -n "$host" ] || continue
    name="${host%.$TLD}"
    if ! ensure_cert "$host"; then
      echo "ldev: skipping https://$host/ (no certificate)" >&2
      skipped=$((skipped + 1))
      continue
    fi
    sed -e "s|__NAME__|$name|g" -e "s|__TLD__|$TLD|g" -e "s|__SITE_DIR__|$dir|g" \
        -e "s|__CERT__|$CERTDIR/$host.pem|g" -e "s|__KEY__|$CERTDIR/$host-key.pem|g" \
        -e "s|__PHP_FPM__|$PHP_FPM|g" -e "s|__LOGDIR__|$LOGDIR|g" \
        "$REPO_DIR/templates/httpd-vhost-site.tmpl" >> "$VHOSTS.new"
    count=$((count + 1))
  done < <(site_pairs)

  # Validate BEFORE replacing the live file. A broken vhost file does not break one site,
  # it stops httpd starting at all — and in this mode httpd is the machine's web server.
  local err rc
  err="$(httpd_validate "$VHOSTS.new")"; rc=$?
  if [ "$rc" != 0 ] && [ "$rc" != 2 ]; then
    echo "INVALID — keeping the previous $VHOSTS" >&2
    printf '%s\n' "$err" >&2
    rm -f "$VHOSTS.new"
    exit 1
  fi
  mv "$VHOSTS.new" "$VHOSTS"
  echo "wrote $VHOSTS ($count site$([ "$count" = 1 ] && echo "" || echo "s") over https)"
  [ "$skipped" = 0 ] || echo "  $skipped skipped for want of a certificate"
  [ "$rc" = 2 ] && echo "  (httpd is not installed — not syntax-checked)"

  grep -qs "Include.*$VHOSTS" "$BREW_PREFIX/etc/httpd/httpd.conf" || {
    printf '\n%sAdd it to httpd.conf, once:%s\n' "$YEL" "$R"
    printf "  echo 'Include %s' >> %s/etc/httpd/httpd.conf\n" "$VHOSTS" "$BREW_PREFIX"
  }
  cmd_restart
}

cmd_apply() {
  [ "$MODE" = "apache" ] && { cmd_apply_apache; return; }
  [ "$MODE" = "auto" ] || { echo "ldev: apply only applies to modes 'auto' and 'apache' (this install is '$MODE')"; exit 1; }
  sed -e "s|__TLD__|$TLD|g" -e "s|__SITES__|$SITES|g" -e "s|__DASHBOARD__|$DASHBOARD|g" \
      -e "s|__PHP_FPM__|$PHP_FPM|g" -e "s|__ADMIN_PORT__|$ADMIN_PORT|g" \
      -e "s|__ASK_PORT__|$ASK_PORT|g" -e "s|__LOGDIR__|$LOGDIR|g" \
      "$REPO_DIR/templates/Caddyfile.auto.tmpl" > "$CADDYFILE"
  echo "wrote $CADDYFILE"
  caddy validate --config "$CADDYFILE" >/dev/null 2>&1 && echo "validates" || { echo "INVALID — not restarting"; exit 1; }
  cmd_restart
}

cmd_restart() {
  if [ "$MODE" = "auto" ]; then
    echo "restarting (needs sudo)..."
    sudo launchctl kickstart -k system/com.ldev.caddy && echo "restarted"
  elif [ "$MODE" = "apache" ]; then
    # Graceful first: it re-reads the config without dropping connections, and in this
    # mode httpd is serving more than ldev. A full restart is the fallback, not the default.
    echo "reloading httpd (needs sudo)..."
    if sudo apachectl -k graceful 2>/dev/null; then echo "reloaded"
    else sudo brew services restart httpd >/dev/null && echo "restarted"; fi
  else
    echo "mode '$MODE' has no single service to restart"
  fi
}

cmd_status() {
  printf '\n  TLD        .%s\n  Sites      %s\n  Mode       %s\n  Dashboard  %s\n\n' "$TLD" "$SITES" "$MODE" "$DASHBOARD"
  if [ "$MODE" = "auto" ]; then
    sudo launchctl print system/com.ldev.caddy 2>/dev/null | awk '/state =|pid =/{print "  "$0}' || echo "  service not loaded"
  elif [ "$MODE" = "apache" ]; then
    printf '  Vhosts     %s\n  Certs      %s\n' "$VHOSTS" "$CERTDIR"
    if pgrep -x httpd >/dev/null 2>&1; then printf '  httpd      running (%s)\n' "$(pgrep -x httpd | tr '\n' ' ')"
    else printf '  httpd      not running\n'; fi
  fi
  printf '\n'
}

case "${1:-doctor}" in
  doctor)  shift; cmd_doctor "$@" ;;
  list|ls) shift; cmd_list "$@" ;;
  new)     shift; cmd_new "$@" ;;
  apply)   shift; cmd_apply "$@" ;;
  restart) shift; cmd_restart "$@" ;;
  status)  shift; cmd_status "$@" ;;
  config)  cat "$CONFIG_FILE" ;;
  -h|--help|help) sed -n '3,12p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "ldev: unknown command '$1' (try: ldev help)" >&2; exit 1 ;;
esac
