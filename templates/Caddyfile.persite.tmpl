# ldev — generated file. Re-generate with `ldev new __NAME__` or edit freely; unlike the
# auto-mode Caddyfile, this one is yours: per-site mode exists so a site can diverge.
#
# MODE: persite (one Caddy process per site, each on its own high port)
#
#   https://__NAME__.__TLD__:__SITE_PORT__   ->  __SITE_DIR__
#
# TWO ports are allocated here, and both must be unique per site:
#
#   site port   __SITE_PORT__   what you browse to
#   admin port  __ADMIN_PORT__   Caddy's local API
#
# The admin port is the one that bites. Caddy binds its admin API on startup, and two
# processes cannot share it — the second does not fall back or warn, it EXITS. So a
# second site that inherits the default 2019 simply never comes up, and the symptom is
# a site that is silently missing rather than an error telling you why.
#
# `ldev new` allocates both in step (8443/2019, 8444/2020, ...) by reading the ports
# already used by sibling site Caddyfiles. If you hand-write one of these, pick a pair
# nobody else is using, or set `admin off` below if you never need the API for this site.

{
	admin localhost:__ADMIN_PORT__
}

__NAME__.__TLD__:__SITE_PORT__ {
	# Plain HTTP on this same port redirects to HTTPS. One block, one port: a separate
	# `http://` block on the same port would be a duplicate address and refuse to load.
	@http protocol http
	redir @http https://__NAME__.__TLD__:__SITE_PORT__{uri} permanent

	# Absolute, not `root * .`. A relative root resolves against the process's working
	# directory, which is whatever launchd or your shell happened to set — and the
	# failure mode is a server that starts cleanly and serves the wrong directory.
	root * __SITE_DIR__

	# Caddy's own CA, per host. A wildcard certificate does NOT work for a single-label
	# parent like .__TLD__: browsers reject *.__TLD__ for __NAME__.__TLD__ with
	# ERR_CERT_COMMON_NAME_INVALID. Swap in `tls <cert> <key>` if you have mkcert files
	# naming this host explicitly.
	tls internal

	encode gzip
	php_fastcgi __PHP_FPM__
	file_server

	log {
		output file __LOGDIR__/__NAME__.access.log {
			roll_size 10MiB
			roll_keep 3
		}
	}
}
