# ldev — generated file. Do not edit by hand; re-run `ldev install` or `ldev apply`.
#
# One Caddy owns 80 + 443 for the whole TLD. There is no second serving mode: this
# file is the whole story for every hostname under .__TLD__.
#
# How a request is served, with no per-site configuration:
#   https://<name>.__TLD__  ->  __SITES__/<name>.__TLD__  or  __SITES__/<name>
#   ...if that directory has an index.php  -> PHP via FastCGI
#   ...if it has an index.html             -> static files
#   ...if it runs its own server           -> proxied to it (see the generated blocks below)
#   ...if it does not exist                -> the dashboard (the fallback)
#
# So adding a site means creating a directory. Nothing else.
#
# A site that needs what this shared server cannot express — its own PHP version, its
# own certificate, a proxy to a running app, or restarts that do not touch its
# neighbours — runs its own Caddy on a high port and is FRONTED by this one. That used
# to be a whole install mode ("persite") that gave up ports 80 and 443, and with them
# the dashboard fallback and portless URLs. It is now a per-site choice that gives up
# nothing: `ldev standalone <name>` writes the site's own Caddyfile, and `ldev apply`
# generates the proxy block for it below.

{
	admin localhost:__ADMIN_PORT__

	# Caddy's own CA, kept on this machine. Each host gets its own certificate the
	# first time it is requested, which is why no wildcard certificate is needed —
	# and a wildcard is exactly what does NOT work here. mkcert's *.__TLD__ file
	# carries specific SANs and browsers reject it for <name>.__TLD__ with
	# ERR_CERT_COMMON_NAME_INVALID. Per-host issuance sidesteps that entirely.
	local_certs

	# Caddy refuses on-demand issuance without an ask endpoint, so that a public
	# instance cannot be made to mint certificates for arbitrary hostnames. Here
	# the endpoint is served by this same Caddy (below), so there is no second
	# process to keep alive.
	on_demand_tls {
		ask http://127.0.0.1:__ASK_PORT__/check
	}
}

# The ask endpoint. Local-only listener: it approves any host, which is correct
# for a machine-local TLD that resolves only to 127.0.0.1.
#
# The 127.0.0.1 in the address above is only a Host-header MATCH — Caddy still binds
# :__ASK_PORT__ on every interface, and any client can send that header. Nothing here
# but a static 200, so nothing leaked; the bind is so the address means what it reads as.
http://127.0.0.1:__ASK_PORT__ {
	bind 127.0.0.1
	respond /check 200
}

# Sites that run their own server, one block each, regenerated by `ldev apply` from the
# Caddyfile found in each site directory. Hand-editing them is pointless — apply
# overwrites the lot. Empty until the first `ldev standalone <name>`.
#
# A named host beats the *.__TLD__ wildcard below regardless of the order they appear in,
# because Caddy chooses the most specific matching site address rather than the first.
__PROXY_SITES__
# Every host under the TLD.
*.__TLD__ {
	# Loopback only — see the note on the http://*.localhost block below. The certificate
	# is not a network boundary: a `curl -k` from any machine on the LAN ignores it, and
	# `file_server browse` further down would then list a site root to whoever asked.
	#
	# Delete this line (and the one in the bare-TLD block) to serve the LAN deliberately.
	bind 127.0.0.1 ::1

	tls {
		on_demand
	}

	# {labels.1} is the label to the left of the TLD: for shop.__TLD__ it is "shop".
	# A multi-label TLD would shift this index, which is why install.sh rejects one.
	#
	# Where a site lives on disk. Two layouts serve the same hostname:
	#
	#   __SITES__/<name>.__TLD__/   explicit — the directory names the host it serves
	#   __SITES__/<name>/           bare — an ordinary project folder
	#
	# Bare is why the suffix is not mandatory: a checkout cloned as ~/Sites/shop is
	# reachable at shop.__TLD__ without being renamed. The suffixed form still wins
	# when both exist, because it names one host exactly and cannot be a coincidence,
	# whereas a bare folder only matches by virtue of what it happens to be called.
	#
	# The match is the hostname, so it is lowercase and has no spaces. macOS is
	# case-insensitive by default, so ~/Sites/ClothingStore does answer to
	# clothingstore.__TLD__ — but ~/Sites/"Scope Canvas" has no reachable hostname at
	# all, because nothing turns a space back into a dash. Rename those.

	encode gzip

	# Four matchers, not two: each layout has to be probed against its own root, and
	# a `file` matcher takes the root it is given rather than the one set for the block.
	@sfx_php file {
		root __SITES__/{labels.1}.__TLD__
		try_files /index.php
	}
	@sfx_static file {
		root __SITES__/{labels.1}.__TLD__
		try_files /index.html
	}
	@bare_php file {
		root __SITES__/{labels.1}
		try_files /index.php
	}
	@bare_static file {
		root __SITES__/{labels.1}
		try_files /index.html
	}

	# handle blocks are mutually exclusive and tried in written order, so the two
	# suffixed cases above the two bare ones IS the precedence rule described above.
	handle @sfx_php {
		root * __SITES__/{labels.1}.__TLD__
		php_fastcgi __PHP_FPM__
		file_server
	}

	handle @sfx_static {
		root * __SITES__/{labels.1}.__TLD__
		file_server browse
	}

	handle @bare_php {
		root * __SITES__/{labels.1}
		php_fastcgi __PHP_FPM__
		file_server
	}

	handle @bare_static {
		root * __SITES__/{labels.1}
		file_server browse
	}

	# No directory for this hostname — hand it to the dashboard rather than a 404,
	# so an unrecognised name tells you what IS configured.
	handle {
		root * __DASHBOARD__
		php_fastcgi __PHP_FPM__
		file_server
	}

	log {
		output file __LOGDIR__/access.log {
			roll_size 10MiB
			roll_keep 3
		}
	}
}

# The same sites over plain HTTP at <name>.localhost.
#
# Browsers resolve *.localhost to loopback themselves — no DNS entry, no
# certificate, nothing to trust. That matters because automated and preview
# browsers (Claude, Playwright sandboxes, some CI images) refuse custom local
# TLDs: the document loads but every subresource is blocked, so a JS app mounts
# nothing and the failure looks like an application bug. Those tools can always
# reach <name>.localhost, so every site has an origin that works headlessly.
#
# {labels.1} is the label left of "localhost": matsu.localhost -> matsu.
http://*.localhost {
	# Loopback only. Nothing here asks for a trusted certificate, so without this any
	# machine on the LAN could send `Host: <name>.localhost` to port 80 and get a site
	# root — with the directory listing below to browse it by.
	bind 127.0.0.1 ::1

	# Where a site lives on disk. Two layouts serve the same hostname:
	#
	#   __SITES__/<name>.__TLD__/   explicit — the directory names the host it serves
	#   __SITES__/<name>/           bare — an ordinary project folder
	#
	# Bare is why the suffix is not mandatory: a checkout cloned as ~/Sites/shop is
	# reachable at shop.__TLD__ without being renamed. The suffixed form still wins
	# when both exist, because it names one host exactly and cannot be a coincidence,
	# whereas a bare folder only matches by virtue of what it happens to be called.
	#
	# The match is the hostname, so it is lowercase and has no spaces. macOS is
	# case-insensitive by default, so ~/Sites/ClothingStore does answer to
	# clothingstore.__TLD__ — but ~/Sites/"Scope Canvas" has no reachable hostname at
	# all, because nothing turns a space back into a dash. Rename those.

	encode gzip

	# Four matchers, not two: each layout has to be probed against its own root, and
	# a `file` matcher takes the root it is given rather than the one set for the block.
	@sfx_php file {
		root __SITES__/{labels.1}.__TLD__
		try_files /index.php
	}
	@sfx_static file {
		root __SITES__/{labels.1}.__TLD__
		try_files /index.html
	}
	@bare_php file {
		root __SITES__/{labels.1}
		try_files /index.php
	}
	@bare_static file {
		root __SITES__/{labels.1}
		try_files /index.html
	}

	# handle blocks are mutually exclusive and tried in written order, so the two
	# suffixed cases above the two bare ones IS the precedence rule described above.
	handle @sfx_php {
		root * __SITES__/{labels.1}.__TLD__
		php_fastcgi __PHP_FPM__
		file_server
	}

	handle @sfx_static {
		root * __SITES__/{labels.1}.__TLD__
		file_server browse
	}

	handle @bare_php {
		root * __SITES__/{labels.1}
		php_fastcgi __PHP_FPM__
		file_server
	}

	handle @bare_static {
		root * __SITES__/{labels.1}
		file_server browse
	}

	handle {
		root * __DASHBOARD__
		php_fastcgi __PHP_FPM__
		file_server
	}
}

# Bare http://localhost is the dashboard too.
http://localhost {
	bind 127.0.0.1 ::1
	root * __DASHBOARD__
	encode gzip
	php_fastcgi __PHP_FPM__
	file_server
}

# The bare TLD (http://__TLD__) is the dashboard's own address.
__TLD__ {
	bind 127.0.0.1 ::1
	tls {
		on_demand
	}
	root * __DASHBOARD__
	encode gzip
	php_fastcgi __PHP_FPM__
	file_server
}
