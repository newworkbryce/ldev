# ldev — generated file. Do not edit by hand; re-run `ldev install` or `ldev apply`.
#
# MODE: auto (one Caddy owns 80 + 443 for the whole TLD)
#
# How a request is served, with no per-site configuration:
#   https://<name>.__TLD__  ->  __SITES__/<name>   (or __SITES__/<name>.__TLD__)
#   ...if that directory has an index.php  -> PHP via FastCGI
#   ...if it has an index.html             -> static files
#   ...if neither directory exists         -> the dashboard (the fallback)
#
# So adding a site means creating a directory named after the site. Nothing else:
# no .__TLD__ suffix on the folder, no config, no restart.

{
	admin localhost:__ADMIN_PORT__

	# Each host gets its own certificate the first time it is requested, which is why
	# no wildcard certificate is needed — and a wildcard is exactly what does NOT work
	# here. A *.__TLD__ file carries specific SANs and browsers reject it for
	# <name>.__TLD__ with ERR_CERT_COMMON_NAME_INVALID. Per-host issuance sidesteps it.
	#
	# Those certificates are signed by MKCERT's root, not by a CA of Caddy's own. The
	# two ways to get a trusted local certificate pull in opposite directions: mkcert
	# issues per host, by hand, ahead of time — which cannot serve a hostname whose
	# folder was created a second ago — while Caddy's `local_certs` issues on demand
	# but from a brand-new root that every browser must be taught to trust.
	#
	# Handing Caddy the mkcert root as its signing CA takes the useful half of each:
	# issuance stays on demand, so a folder is still a site, and the chain ends at a
	# root already in the System keychain, so nothing new has to be trusted and
	# `caddy trust` is not needed at all. Verified: a client trusting only
	# rootCA.pem gets 200, with the leaf issued by "<ca name> - ECC Intermediate".
	#
	# The key is readable only by its owner, and this server runs as root, so it can
	# read it. If mkcert has never been run, __MKCERT_ROOT__ does not exist and Caddy
	# fails at startup rather than quietly falling back — install.sh checks first.
	pki {
		ca local {
			name "ldev local CA (mkcert root)"
			root {
				cert "__MKCERT_ROOT__/rootCA.pem"
				key "__MKCERT_ROOT__/rootCA-key.pem"
			}
		}
	}

	# Caddy refuses on-demand issuance without an ask endpoint, so that a public
	# instance cannot be made to mint certificates for arbitrary hostnames. Here
	# the endpoint is served by this same Caddy (below), so there is no second
	# process to keep alive.
	on_demand_tls {
		ask http://127.0.0.1:__ASK_PORT__/check
	}
}

# The ask endpoint. Local-only listener: it approves any host, which is correct
# for a machine-local TLD that resolves only to 127.0.0.1.
#
# The 127.0.0.1 in the address above is only a Host-header MATCH — Caddy still binds
# :__ASK_PORT__ on every interface, and any client can send that header. Nothing here
# but a static 200, so nothing leaked; the bind is so the address means what it reads as.
http://127.0.0.1:__ASK_PORT__ {
	bind 127.0.0.1
	respond /check 200
}

# Every host under the TLD.
*.__TLD__ {
	# Loopback only — see the note on the http://*.localhost block below. The certificate
	# is not a network boundary: a `curl -k` from any machine on the LAN ignores it, and
	# `file_server browse` further down would then list a site root to whoever asked.
	#
	# Delete this line (and the one in the bare-TLD block) to serve the LAN deliberately.
	bind 127.0.0.1 ::1

	tls {
		# Signed by the mkcert root defined in the pki block above, not by a CA of
		# Caddy's own — so the chain ends at a root the System keychain already has.
		issuer internal {
			ca local
		}
		on_demand
	}

	# {labels.1} is the label to the left of the TLD: for shop.__TLD__ it is "shop".
	# A multi-label TLD would shift this index, which is why install.sh rejects one.
	#
	# Two directory layouts answer to that name, and the PLAIN one wins:
	#
	#   __SITES__/shop            ->  https://shop.__TLD__     (what `ldev new` writes)
	#   __SITES__/shop.__TLD__    ->  https://shop.__TLD__     (older installs, still served)
	#
	# The suffix was never load-bearing — the hostname supplies it — and requiring it
	# meant every existing project folder had to be renamed before it could be served.
	# Caddy applies these in order and the last matching `root` wins, so the suffixed
	# form is set unconditionally as the fallback and the plain folder overrides it
	# whenever one exists. A site with both folders is served from the plain one.
	root * __SITES__/{labels.1}.__TLD__

	# The match is the hostname, so it is lowercase and has no spaces. macOS is
	# case-insensitive by default, so __SITES__/ClothingStore does answer to
	# clothingstore.__TLD__ — but __SITES__/"Scope Canvas" has no reachable hostname at
	# all, because nothing turns a space back into a dash. `ldev list` counts those and
	# says to rename them, rather than printing a URL that cannot work.
	@plain file {
		root __SITES__/{labels.1}
		try_files /index.php /index.html
	}
	root @plain __SITES__/{labels.1}

	encode gzip

	# The file matcher resolves against the root set above, so these two answer
	# "does a site directory exist for this hostname, and what kind is it?"
	@php file /index.php
	@static file /index.html

	handle @php {
		php_fastcgi __PHP_FPM__
		file_server
	}

	handle @static {
		file_server browse
	}

	# No directory for this hostname — hand it to the dashboard rather than a 404,
	# so an unrecognised name tells you what IS configured.
	handle {
		root * __DASHBOARD__
		php_fastcgi __PHP_FPM__
		file_server
	}

	log {
		output file __LOGDIR__/access.log {
			roll_size 10MiB
			roll_keep 3
		}
	}
}

# The same sites over plain HTTP at <name>.localhost.
#
# Browsers resolve *.localhost to loopback themselves — no DNS entry, no
# certificate, nothing to trust. That matters because automated and preview
# browsers (Claude, Playwright sandboxes, some CI images) refuse custom local
# TLDs: the document loads but every subresource is blocked, so a JS app mounts
# nothing and the failure looks like an application bug. Those tools can always
# reach <name>.localhost, so every site has an origin that works headlessly.
#
# {labels.1} is the label left of "localhost": matsu.localhost -> matsu.
http://*.localhost {
	# Loopback only. Nothing here asks for a trusted certificate, so without this any
	# machine on the LAN could send `Host: <name>.localhost` to port 80 and get a site
	# root — with the directory listing below to browse it by.
	bind 127.0.0.1 ::1

	# Same two layouts as the block above, resolved the same way: plain folder wins,
	# suffixed folder still works. Both origins must agree on which directory a name
	# means, or a site would render differently depending on how you reached it.
	root * __SITES__/{labels.1}.__TLD__

	# The match is the hostname, so it is lowercase and has no spaces. macOS is
	# case-insensitive by default, so __SITES__/ClothingStore does answer to
	# clothingstore.__TLD__ — but __SITES__/"Scope Canvas" has no reachable hostname at
	# all, because nothing turns a space back into a dash. `ldev list` counts those and
	# says to rename them, rather than printing a URL that cannot work.
	@plain file {
		root __SITES__/{labels.1}
		try_files /index.php /index.html
	}
	root @plain __SITES__/{labels.1}

	encode gzip

	@php file /index.php
	@static file /index.html

	handle @php {
		php_fastcgi __PHP_FPM__
		file_server
	}

	handle @static {
		file_server browse
	}

	handle {
		root * __DASHBOARD__
		php_fastcgi __PHP_FPM__
		file_server
	}
}

# Bare http://localhost is the dashboard too.
http://localhost {
	bind 127.0.0.1 ::1
	root * __DASHBOARD__
	encode gzip
	php_fastcgi __PHP_FPM__
	file_server
}

# The bare TLD (http://__TLD__) is the dashboard's own address.
__TLD__ {
	bind 127.0.0.1 ::1
	tls {
		# Signed by the mkcert root defined in the pki block above, not by a CA of
		# Caddy's own — so the chain ends at a root the System keychain already has.
		issuer internal {
			ca local
		}
		on_demand
	}
	root * __DASHBOARD__
	encode gzip
	php_fastcgi __PHP_FPM__
	file_server
}
